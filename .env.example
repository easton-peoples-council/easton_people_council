# Easton People Council — environment variables
#
# Copy to .env and fill in the values:  cp .env.example .env
# .env is gitignored. Never commit real values.
#
# Every key below is read somewhere in the code. The comment says what breaks
# if it is missing. All of them fail soft rather than crashing the site — with
# one exception, DATABASE_URL — which makes a missing key easy to overlook.

# ── Qomon (campaign CRM — the system of record for people) ───────────────────

# Bearer token for https://incoming.qomon.app. Read in lib/qomon.ts.
# Without it: signups and boundary submissions fail, and the "N people have
# already signed up!" counter disappears from every page.
QOMON_API_KEY=

# Optional. Numeric id of a Qomon custom field used to mark contacts who have
# drawn a boundary. Read in app/api/boundary/route.ts. Needs a paid Qomon tier.
# Without it: submissions still succeed and still land in Neon; the contact is
# upserted to Qomon without the marker field.
QOMON_BOUNDARY_FIELD_ID=

# ── Neon (Postgres — stores drawn map boundaries) ────────────────────────────

# Pooled connection string for the Neon database. Read in lib/db.ts. Stores the
# polygons drawn on /map and nothing else — no personal data.
# Neon console → your project → Connect → "Connection string", with
# "Connection pooling" ON (the host then contains "-pooler"). Keep ?sslmode=require.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Run `npm run db:schema` once against it before the first submission.
# Quotes around the value are fine — dotenv strips them.
# Without it: POST /api/boundary returns 500 "Server error" and the resident's
# drawn boundary is lost — this is the one key that does NOT fail soft.
DATABASE_URL=

# ── Calendar ─────────────────────────────────────────────────────────────────

# URL of the iCal (.ics) feed for campaign events. Read in app/api/events/route.ts.
# Must start with http — the route checks.
# Without it: GET /api/events returns [] with status 503 and the homepage
# calendar shows "No upcoming events at the moment."
CALENDAR_URL=

# ── DatoCMS (headless CMS behind /press) ─────────────────────────────────────

# Content Delivery API token — published content only. Read in lib/datocms.ts.
# DatoCMS: Project settings → API tokens.
# Without it: /press renders with an empty article list (the fetch error is
# logged to the server console, not shown to the user).
DATOCMS_API_TOKEN=

# Optional. Token with "Can access draft content" enabled, used by /press?preview=1.
# Without it: ?preview=1 still renders the "Preview mode" banner but silently
# shows published content only.
DATOCMS_PREVIEW_TOKEN=

# ── Behold (hosted Instagram feed behind the photo strips) ───────────────────

# JSON feed URL for the campaign's Instagram account. Read in lib/instagram.ts.
# Must start with http — the lib checks.
# Behold dashboard → Feeds → your JSON feed → copy the feed URL:
#   https://feeds.behold.so/FEED_ID
# The connected Instagram account must be a Business or Creator account —
# Instagram no longer lets Behold connect personal ones.
# Leave Behold's domain whitelist OFF: the fetch is server-side, so there is
# no browser origin for it to match and a whitelist blocks the request.
# Without it: getInstagramPosts() returns [] and every strip renders nothing.
# The pages look completely normal, just with no photos — easy to miss.
BEHOLD_FEED_URL=

# ── Cloudflare Turnstile (bot protection on both forms) ─────────────────────

# Public site key. NEXT_PUBLIC_ prefix is required — this one reaches the browser.
# Read in app/SignupForm.tsx and components/BoundaryMap.tsx.
# Without it: forms render "Verification is currently unavailable" and the
# submit button stays disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key, server-side only. Read in lib/validation.ts.
# Without it: every form POST returns 500 "Turnstile secret is not configured".
TURNSTILE_SECRET_KEY=

# Put the REAL keys here and leave them here. You do not need to swap them for
# local work: `.env.development` (committed) holds Cloudflare's test keys and
# `next dev` loads it in preference to this file, so both keys switch together
# as a matched pair. See docs/development.md#turnstile.
